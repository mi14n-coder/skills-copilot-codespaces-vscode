# Alpaca API Credentials
# Get your API keys from: https://app.alpaca.markets/paper/dashboard/overview
# For paper trading, use paper trading keys
# For live trading, use live trading keys

ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Trading Mode: set to 'true' for paper trading, 'false' for live trading
PAPER_TRADING=true

# Email Notifications (Optional)
EMAIL_ENABLED=false
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_RECEIVER=receiver_email@gmail.com

# Trading Configuration
PROFIT_TARGET_PERCENT=2.0
MIN_CASH_BALANCE=10.0
